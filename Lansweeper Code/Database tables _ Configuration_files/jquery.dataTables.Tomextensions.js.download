//auto detect ip addresses
jQuery.fn.dataTableExt.aTypes.push(
    function (sData) {
        var ret = /^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/i.test(sData);

       // alert(sData +"--"+ret);
        if (ret) return 'ip-address';
        else return null;
    }
);