}, "'domain\\username' OR '.\\username'");
jQuery.validator.addClassRules("windowslogin", { windowslogin: true });*/


jQuery.validator.addMethod("oswaittime", function (value, element) {
    return this.optional(element) || /^[0-5]$/i.test(value);
}, "Value must be between 0 and 5");
jQuery.validator.addClassRules("oswaittime", { oswaittime: true });



jQuery.validator.addMethod("netbios", function (value, element) {
    var tester = value;
    if (value.indexOf("\\") != -1) tester = value.split("\\")[0];
    if(this.optional(element) || /^.{0,15}$/i.test(tester)) {
        if(tester.indexOf('/') === -1 && tester.indexOf(':') === -1 && tester.indexOf('*') === -1 && tester.indexOf('?') === -1 && tester.indexOf('"') === -1 && tester.indexOf('|') === -1  && tester.indexOf('<') === -1  && tester.indexOf('>') === -1) return true;
        else return false;
    }
    else return false; 
}, 'Netbiosname cannot be longer than 15 characters and cannot contain the following characters: / * ? " | < > :');
jQuery.validator.addClassRules("netbios", { netbios: true });

jQuery.validator.addMethod("adsi", function (value, element) {
    var t = value || "";
    var ret = false;
    if (t.toLowerCase().indexOf("dc=") == -1) ret = true;
    return this.optional(element) || !ret;
}, "Adsi path has to contain 'dc='");
jQuery.validator.addClassRules("adsi", { adsi: true });


jQuery.validator.addMethod("dns", function (value, element) {

    var ret = false;
    if (value.indexOf(".") == -1) ret = true;

    return this.optional(element) || !ret;
}, "DNS name has to contain '.'");
jQuery.validator.addClassRules("dns", { dns: true });


jQuery.validator.addMethod("endip", function (value, element) {
    var ret = false;

    var star = $(element).closest("form").find(".startip").val(); //in popup
    if (star == undefined) star = $(element).closest("tr").find(".startip").html(); //in table
    
    var start = dot2num(star);
    var end = dot2num(value);
    if (start <= end) ret = true;

    return this.optional(element) || ret;
}, "End IP has to be bigger than Start IP");
jQuery.validator.addClassRules("endip", { endip: true });


jQuery.validator.addMethod("startip", function (value, element) {
    var ret = false;


    var star = $(element).closest("form").find(".endip").val(); //in popup
    //START DO ONLY in table !!!
    if (star == undefined) {
        star = $(element).closest("tr").find(".endip").html(); //in table

        var start = dot2num(value);
        var end = dot2num(star);
        if (start <= end) ret = true;
    } else {
        ret = true;
    }

    return this.optional(element) || ret;
}, "Start IP has to be smaller than End IP");
jQuery.validator.addClassRules("startip", { startip: true });







jQuery.validator.addMethod("uniquewindows", function (value, element) {

    var r = false;
    if (value.indexOf("\\") == -1) r = true;
    if (!element.classList.contains('netbios')) {

        if (value.indexOf(".") == 0) r = true;
    }

    return this.optional(element) || !r;
    //return this.optional(element) || /^\.\\\w+|\w+\\\w+$/i.test(value);
}, "'domain\\computername' OR 'WORKGROUP\\computername'");
jQuery.validator.addClassRules("uniquewindows", { uniquewindows: true });





//(([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)(\s*;\s*|\s*$))*

jQuery.validator.addMethod("emailgroup", function (value, element, param) {
    return this.optional(element) || /^((([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{1,15}|[0-9]{1,15})(\]?)(\s*;\s*|\s*$)))*$/i.test(value);
}, "Please enter a valid email address group.");
jQuery.validator.addClassRules("emailgroup", { emailgroup: true });

jQuery.validator.addMethod("webrol", function (value, element) {

    return true;

    var or = false;
    var mem = value.split(",");
    for (var i = 0; i < mem.length; i++) {
        var tester = mem[i];
        if (mem[i].indexOf("\\") != -1) tester = mem[i].split("\\")[0];

        or = /^.{0,15}$/i.test(tester) || or;
    }




    return this.optional(element) || or;
}, "Invalid group name");
jQuery.validator.addClassRules("webrol", { webrol: true });



function dot2num(dot) {
    var d = dot.split('.');
    return ((((((+d[0]) * 256) + (+d[1])) * 256) + (+d[2])) * 256) + (+d[3]);
}

jQuery.validator.addMethod("snmpoid", function (value, element, param) {
    return this.optional(element) || /^([1-9][0-9]{0,}|0)(\.([1-9][0-9]{0,}|0)){5,500}$/.test(value);
}, "Please enter a valid OID.");
jQuery.validator.addClassRules("snmpoid", { snmpoid: true });

jQuery.validator.addMethod("json", function (value, element, param) {
    if (value === '*****') return true;
    try {
        JSON.parse(value);
    }
    catch (ex) {
        return false;
    }
    return true;
}, "Please enter a valid JSON string.");
jQuery.validator.addClassRules("json", { json: true });

jQuery.validator.addMethod("assetexclusionreason", function (value, element, param) {
    return this.optional(element) || /([1-9]\d*$)|-1/.test(value);
}, "Please select a valid exclusion reason.");
jQuery.validator.addClassRules("assetexclusionreason", { assetexclusionreason: true });

jQuery.validator.addMethod("maxlength255", function (value, element, param) {
    return this.optional(element) || /^\s*([^\s]\s*){0,255}$/.test(value);
}, "Your input contains too many characters. Only 255 characters are allowed.");
jQuery.validator.addClassRules("maxlength255", { maxlength255: true });
